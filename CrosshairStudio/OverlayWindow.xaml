<Window x:Class="CrosshairStudio.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" Left="0" Top="0">
    <!-- ShowActivated="False": окно показывается, но НЕ забирает фокус у игры. -->
    <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False"/>
</Window>
