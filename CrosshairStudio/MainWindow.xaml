<Window x:Class="CrosshairStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Studio" Height="720" Width="1120"
        MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen"
        Background="#101319" Foreground="#F1F5F9">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#273241"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111821"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#354254"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#58D68D"/>
            <Setter Property="Foreground" Value="#101319"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151A22" BorderBrush="#26303C" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="CROSSHAIR" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="STUDIO" FontSize="18" FontWeight="Bold" Foreground="#58D68D"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <Button Content="Launcher" Style="{StaticResource NavButton}" Click="Launcher_Click"/>
                    <Button Content="Studio" Style="{StaticResource NavButton}" Click="Studio_Click"/>
                    <Button Content="Presets" Style="{StaticResource NavButton}" Click="Presets_Click"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" Grid.Row="2" Text="Crosshair Studio 1.0"
                           Foreground="#718096" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22">
            <Border x:Name="LauncherPanel" CornerRadius="18" ClipToBounds="True" Background="#191F29">
                <Grid>
                    <Image Source="/Assets/launcher.png" Stretch="UniformToFill"/>
                    <Border Background="#CC101319" VerticalAlignment="Bottom" Padding="28">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="CROSSHAIR STUDIO" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Налаштуйте приціл. Запустіть оверлей." Foreground="#9AA7B7" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Studio" Style="{StaticResource AccentButton}" Click="Studio_Click" Margin="0,0,10,0"/>
                                <Button Content="Перевірити оновлення" Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="StudioPanel" Background="#191F29" CornerRadius="16" Padding="18" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="STUDIO" FontSize="13" FontWeight="Bold" Foreground="#58D68D"/>
                    <Border Grid.Row="1" Background="#0B1017" CornerRadius="12" Margin="0,14" ClipToBounds="True">
                        <Grid x:Name="PreviewArea" SizeChanged="PreviewArea_SizeChanged">
                            <TextBlock Text="ПРЕВ’Ю ПРИЦЕЛА" Foreground="#354254" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2">
                        <Button DockPanel.Dock="Left" Content="Відкрити налаштування" Click="Settings_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Увімкнути оверлей" Style="{StaticResource AccentButton}" Click="ToggleOverlay_Click"/>
                            <Button Content="Приховати" Click="HideOverlay_Click" Margin="10,5,0,5"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="PresetsPanel" Background="#191F29" CornerRadius="16" Padding="22" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="PRESETS" FontSize="20" FontWeight="Bold" Foreground="#58D68D"/>
                        <TextBlock Text="Бібліотека прицілів" Foreground="#9AA7B7" Margin="0,5,0,16"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="ВБУДОВАНІ" FontWeight="SemiBold" Foreground="#9AA7B7" Margin="0,0,0,8"/>
                            <Button Content="Classic Green" Click="ClassicGreen_Click"/>
                            <Button Content="Small Dot" Click="SmallDot_Click"/>
                            <Button Content="Cyan Cross" Click="CyanCross_Click"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#111821" CornerRadius="12" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="МОЇ ПРЕСЕТИ" FontWeight="SemiBold" Foreground="#9AA7B7" Margin="0,0,0,8"/>
                                <ListBox x:Name="PresetList" Background="#111821" Foreground="#F1F5F9" BorderBrush="#354254"
                                         SelectionChanged="PresetList_SelectionChanged"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="Пресети зберігаються у JSON." Foreground="#9AA7B7" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Оновити список" Click="RefreshPresets_Click"/>
                            <Button Content="Зберегти поточний" Style="{StaticResource AccentButton}" Click="SavePreset_Click" Margin="10,5,0,5"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel" Background="#191F29" CornerRadius="16" Padding="22" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" Foreground="#58D68D" Margin="0,0,0,14"/>
                            <TextBlock Text="Колір приціла" FontWeight="SemiBold"/>
                            <DockPanel>
                                <TextBox x:Name="ColorBox" Text="#58D68D" Width="130" VerticalContentAlignment="Center"/>
                                <Button Content="Застосувати" Click="ApplyColor_Click" Margin="8,5,0,10"/>
                            </DockPanel>
                            <TextBlock Text="Розмір"/>
                            <Slider x:Name="SizeSlider" Minimum="8" Maximum="60" Value="24" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="SizeValue" Text="24 px" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <TextBlock Text="Товщина"/>
                            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="8" Value="3" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="ThicknessValue" Text="3 px" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <TextBlock Text="Форма"/>
                            <ComboBox x:Name="ShapeCombo" SelectedIndex="3" SelectionChanged="Setting_Changed" Margin="0,5,0,10">
                                <ComboBoxItem Content="Dot"/>
                                <ComboBoxItem Content="Circle"/>
                                <ComboBoxItem Content="Square"/>
                                <ComboBoxItem Content="Cross"/>
                                <ComboBoxItem Content="T"/>
                            </ComboBox>
                            <CheckBox x:Name="OutlineCheck" Content="Обводка" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,5,0,5"/>
                            <TextBlock Text="Товщина обводки"/>
                            <Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="5" Value="1" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="OutlineThicknessValue" Text="1 px" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <CheckBox x:Name="DotCheck" Content="Точка в центрі" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,5,0,10"/>
                            <CheckBox x:Name="PulseCheck" Content="Пульсація" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <TextBlock Text="Швидкість пульсації"/>
                            <Slider x:Name="PulseSpeedSlider" Minimum="0.5" Maximum="5" Value="2" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PulseSpeedValue" Text="2.0" Foreground="#9AA7B7" Margin="0,-8,0,8"/>
                            <TextBlock Text="Сила пульсації"/>
                            <Slider x:Name="PulseStrengthSlider" Minimum="0" Maximum="0.8" Value="0.25" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PulseStrengthValue" Text="25 %" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <CheckBox x:Name="RecoilCheck" Content="Віддача" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <TextBlock Text="Сила віддачі"/>
                            <Slider x:Name="RecoilAmountSlider" Minimum="0" Maximum="30" Value="8" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="RecoilAmountValue" Text="8 px" Foreground="#9AA7B7" Margin="0,-8,0,8"/>
                            <TextBlock Text="Швидкість віддачі"/>
                            <Slider x:Name="RecoilSpeedSlider" Minimum="0.5" Maximum="5" Value="2" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="RecoilSpeedValue" Text="2.0" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <CheckBox x:Name="GradientCheck" Content="Градієнт" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <TextBlock Text="Другий колір"/>
                            <TextBox x:Name="SecondaryColorBox" Text="#FFFFFF" TextChanged="SecondaryColorBox_TextChanged"/>
                            <TextBlock Text="Прозорість"/>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="OpacityValue" Text="100 %" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                            <TextBlock Text="Зсув X"/>
                            <Slider x:Name="OffsetXSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/>
                            <TextBlock Text="Зсув Y"/>
                            <Slider x:Name="OffsetYSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="OffsetValue" Text="X: 0   Y: 0" Foreground="#9AA7B7" Margin="0,-8,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ОВЕРЛЕЙ" FontWeight="SemiBold" Foreground="#9AA7B7" Margin="0,0,0,8"/>
                        <TextBlock Text="Монітор"/>
                        <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged" Margin="0,5,0,15"/>
                        <Button Content="Завантажити зображення" Click="LoadImage_Click"/>
                        <TextBlock x:Name="ImageStatus" Text="Зображення не вибрано" Foreground="#9AA7B7" FontSize="11" TextWrapping="Wrap"/>
                        <Button Content="Прибрати зображення" Click="RemoveImage_Click"/>
                        <Button Content="Зберегти пресет" Style="{StaticResource AccentButton}" Click="SavePreset_Click" Margin="0,18,0,5"/>
                        <Button Content="Перевірити оновлення" Click="CheckUpdates_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
